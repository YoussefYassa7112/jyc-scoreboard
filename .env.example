# Neon Postgres connection string (from neon.tech or Vercel Marketplace)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin login password (shared among camp staff)
ADMIN_PASSWORD=change-me-camp-admin

# Secret used to sign the admin session cookie (long random string)
AUTH_SECRET=replace-with-a-long-random-secret
